# Zkopíruj na .env a vyplň:  cp .env.example .env
# .env obsahuje hesla: nikomu ho neposílej a nedávej do gitu (je v .gitignore).

# ---------- Povinné ----------
# Účet Webshare (bez VIP to jde, ale hodně pomalu)
WS_USER=
WS_PASS=

# Přihlášení na stránku stahovače (umí mazat filmy, takže silné heslo).
# Bez WEB_PASS stránka nic neukáže.
WEB_USER=admin
WEB_PASS=

# Složka, kam se filmy stahují. Vzniknou v ní filmy/ a serialy/.
# Jellyfin musí číst stejnou složku. Linux: /cesta/k/media, Windows (Docker Desktop): C:/Media
MEDIA_DIR=./media

# Na jaké adrese stránka poslouchá. 127.0.0.1 = jen tenhle počítač.
# Z telefonu nebo televize v domácí síti: adresa serveru, třeba 192.168.1.10. Nikdy 0.0.0.0 na serveru s veřejnou IP.
BIND_IP=127.0.0.1

# Pod jakým uživatelem se zapisuje (Linux: příkaz `id`, obvykle 1000). Na Windows nech být.
PUID=1000
PGID=1000

# ---------- Jellyfin (doporučené) ----------
# Bez toho stahovač funguje, jen Jellyfin pozná nový film až při svém plánovaném skenu
# a stránka neukáže plakáty ani co je zhlédnuté.
# Adresa Jellyfinu, jak ji vidí kontejner stahovače:
#   Jellyfin z tohohle docker-compose (--profile jellyfin): http://jellyfin:8096
#   Jellyfin jinde (jiný počítač, LXC na Proxmoxu):          http://192.168.1.20:8096
JELLYFIN_URL=
# Klíč API: Jellyfin → Ovládací panel → Klíče API → +
JELLYFIN_TOKEN=
# Pod jakou cestou vidí Jellyfin složku MEDIA_DIR (v knihovně Filmy je pak .../filmy).
# Docker Jellyfin z tohohle compose: /media. Jellyfin v LXC: cesta uvnitř LXC, třeba /mnt/media
JELLYFIN_MEDIA_PATH=/media
# Adresa pro tlačítko „Přehrát v Jellyfinu“ v prohlížeči. Prázdné = stejný počítač jako stahovač, port 8096.
JELLYFIN_PUBLIC_URL=

# ---------- Nepovinné ----------
# Stránka Objevit a wishlist: „API Read Access Token“ z themoviedb.org (Nastavení → API), zdarma
TMDB_TOKEN=

# Fastshare (předplatné + v Můj účet zapnuté Přímé stahování)
FASTSHARE_USER=
FASTSHARE_PASS=

# Další uživatelé (třeba rodina): smí přidat stahování a sahat jen na svoje, mazat ne.
# Formát: jmeno:heslo,jmeno2:heslo2
FAMILY_USERS=

# Když se v Jellyfinu kouká, stahování zpomalí na tuhle rychlost (ať se film na pomalém disku nesekal)
THROTTLE_LIMIT=40M
